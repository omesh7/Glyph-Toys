<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DVD Bounce"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Retro Flip-to-Glyph Toy"
            android:textColor="#666666"
            android:layout_marginBottom="48dp" />

        <Button
            android:id="@+id/btn_open_glyph_tools"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open Glyph Tools"
            android:textColor="#000000"
            android:backgroundTint="#FFFFFF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="\nFlip your phone face-down\nto see the logo bounce!"
            android:textColor="#444444"
            android:textSize="12sp"
            android:layout_marginTop="32dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/creditsText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="#666666"
        android:textSize="14sp"
        android:paddingBottom="8dp" />

</LinearLayout>
