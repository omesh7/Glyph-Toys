<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.nothing.glyph.toys.dvdbounce">

    <!-- Required for Glyph Toys -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <!-- Foreground service permissions (already correct) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <application
        android:allowBackup="true"
        android:label="DVD Bounce"
        android:theme="@style/Theme.Bounce">

        <!-- Nothing SDK development key (keep for testing) -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <!-- Main launcher activity (already perfect) -->
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- FIXED & COMPLETE Glyph Toy Service -->
        <service
            android:name=".BounceService"
            android:exported="true"
            android:foregroundServiceType="specialUse">

            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_name" />

            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_summary" />

            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_preview" />

            <!-- Mandatory for Nothing Phone (4a) Pro — no Glyph Touch, AOD is the trigger -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

    </application>
</manifest>