<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:text="Anicca"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="impermanence · glyph toy"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginBottom="32dp" />

    <!-- Simulated Matrix Preview -->
    <View
        android:id="@+id/matrixPreview"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:background="#060606"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/pname"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Phase 1 · Settling"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/pdesc"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Sankharas rising and passing on the surface mind"
        android:textColor="#999999"
        android:textSize="12sp"
        android:layout_marginTop="4dp" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0 / 30 min"
        android:textColor="#444444"
        android:textSize="11sp"
        android:layout_marginTop="8dp" />

    <SeekBar
        android:id="@+id/progSlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FFFFFF"
        android:thumbTint="#FFFFFF" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/playBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Play session"
            android:textAllCaps="false"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF" />

        <Space android:layout_width="8dp" android:layout_height="wrap_content" />

        <Button
            android:id="@+id/resetBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reset"
            android:textAllCaps="false"
            android:backgroundTint="#1A1A1A"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Duration"
        android:textColor="#666666"
        android:textSize="12sp"
        android:layout_marginTop="24dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp">

        <Button android:id="@+id/btn10" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="10m" android:backgroundTint="#0D0D0D" />
        <Button android:id="@+id/btn30" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30m" android:backgroundTint="#1A1A1A" />
        <Button android:id="@+id/btn45" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="45m" android:backgroundTint="#0D0D0D" />
        <Button android:id="@+id/btn60" style="?android:attr/buttonStyleSmall" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="60m" android:backgroundTint="#0D0D0D" />
    </LinearLayout>

</LinearLayout>
