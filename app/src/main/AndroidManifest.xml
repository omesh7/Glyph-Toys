<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.GlyphToys">

        <!--
          API key enforcement was removed in Android 16, and Nothing's own 2026 sample still
          ships "test". Kept for stability across older Nothing OS builds.
        -->
        <meta-data
            android:name="NothingKey"
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".toys.ChargeToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_charge_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_charge" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_charge_summary" />
            <!-- Required on Phone (4a) Pro: it has no Glyph button, AOD is the only mode. -->
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <service
            android:name=".toys.AlbumArtToyService"
            android:exported="true"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <meta-data
                android:name="com.nothing.glyph.toy.name"
                android:resource="@string/toy_album_name" />
            <meta-data
                android:name="com.nothing.glyph.toy.image"
                android:resource="@drawable/toy_album" />
            <meta-data
                android:name="com.nothing.glyph.toy.summary"
                android:resource="@string/toy_album_summary" />
            <meta-data
                android:name="com.nothing.glyph.toy.aod_support"
                android:value="1" />
        </service>

        <!--
          Not used for notifications. MediaSessionManager.getActiveSessions only answers callers
          that are enabled notification listeners, and declaring this service is the only way to
          become one.
        -->
        <service
            android:name=".media.GlyphNotificationListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
